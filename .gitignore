# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Secrets
.env
*.key

# Server runtime log. Anchored to the root so bench/logs/*.log -- which are
# committed evidence -- are not swept up with it.
/subagents.log

# Server state (SQLite lands beside the server; WAL mode adds -wal/-shm)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Bench fixture is BUILT from bench/fixture_src/ by bench/setup.sh.
# It carries its own nested .git, which would become a gitlink here.
bench/fixture_repo/

# Stale snapshot archives of bench/ and probe/, superseded by the live dirs
*.zip

# Job-application strategy notes — internal, not part of the public repo.
ZUDDL.md

# Internal planning / strategy docs — kept locally, not part of the public repo.
CONTEXT.md

# A/B measurement scratch workspaces, materialised per run.
bench/ab/work/

# The probe server is still registered in the client, so it starts whenever the
# client does. It logs here; probe/probe.log is committed evidence and must not
# be appended to (see probe/probe_server.py).
probe/probe.live.log
