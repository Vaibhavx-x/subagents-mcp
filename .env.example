# Copy to .env and edit. .env is gitignored; never commit real values.

# Absolute path to the Python interpreter that has `mcp` installed.
# `python` is ambiguous on this machine: 3.13 has mcp, 3.11 does not.
SUBAGENTS_PYTHON=C:/Python313/python.exe

# Absolute path to the agy CLI. Resolves on PATH, but pin it for subprocesses.
SUBAGENTS_AGY_PATH=C:/Users/<you>/AppData/Local/agy/bin/agy.exe

# Colon-or-semicolon separated allowlist of permitted workspace roots.
# `workspace_root` is a required tool parameter and is cross-checked against
# this list after symlink resolution. Nothing outside it executes.
SUBAGENTS_ALLOWED_ROOTS=D:/Projects/subagents-mcp

# Where the SQLite database lands. Relative paths resolve against the server's
# cwd, which the client config pins explicitly.
SUBAGENTS_DB_PATH=subagents.db

# Worker model. Effort is encoded in the model id (see `agy models`); there is
# no separate --effort flag.
SUBAGENTS_MODEL=gemini-3.8-flash-low
SUBAGENTS_MODEL_ESCALATE=gemini-3.7-flash-medium

# Per-worker wall-clock budget, passed as `--print-timeout`.
# Measured: agy adds ~9.7s of process startup on top of this.
SUBAGENTS_WORKER_TIMEOUT_S=600

# Max workers running concurrently within a single wave.
SUBAGENTS_MAX_PARALLEL=4

# Seconds a proposed plan stays executable before its approval goes stale.
SUBAGENTS_PLAN_TTL_S=900

# Semicolon-separated globs excluded from taint detection, on top of the
# defaults (*.log, *.tmp, *.swp, *.pyc, *~ and the .git/__pycache__/.venv
# directories). Anything writing inside the workspace during a run looks like a
# worker -- an editor autosaving, a watcher rebuilding, another MCP server
# appending to its log -- and would otherwise mark every run tainted.
# Example: SUBAGENTS_TAINT_IGNORE=dist/*;*.generated.ts
SUBAGENTS_TAINT_IGNORE=

# Logging. NEVER log to stdout: stdout is the MCP protocol channel.
SUBAGENTS_LOG_FILE=subagents.log
SUBAGENTS_LOG_LEVEL=INFO

# NOT set by you. The server sets SUBAGENTS_DEPTH=1 in every worker it spawns,
# and refuses execute_plan when it sees it -- a worker keeps every other MCP
# server, tool and skill, but cannot fan out again. Setting it by hand here
# would disable execution entirely.
